# PostgreSQL connection string (local Postgres, Supabase, Neon...). Add ?sslmode=require for hosted DBs.
DATABASE_URL=postgres://USER@localhost:5432/vaultportal

# Long random string used to sign file links and share tokens. Generate: openssl rand -hex 32
APP_SECRET=change-me

# Public base URL used in share links and credential messages (on Vercel, falls back to the production domain)
APP_URL=http://localhost:3000

# Protects /api/cron/* endpoints (sent as Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me

# Where uploaded files are stored when no cloud storage is configured (local dev / VPS)
STORAGE_DIR=./storage

# Vercel Blob (private). Set automatically when a Blob store is connected to the Vercel project
# (new stores use OIDC + BLOB_STORE_ID; older ones BLOB_READ_WRITE_TOKEN). When either is set,
# uploads go to Blob instead of STORAGE_DIR.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Optional: email notifications via Resend. Without it, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="Vault Media House <billing@example.com>"

# First admin account created by `npm run db:seed`
SEED_ADMIN_USERNAME=chief
SEED_ADMIN_PASSWORD=
